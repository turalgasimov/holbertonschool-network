#!/usr/bin/env bash
# This script checks if a given host is reachable on the network by pinging it 5 times.
# Check if an argument was passed
if [ -z "$1" ]; then
    echo "Usage: 5-is_the_host_on_the_network {IP_ADDRESS}"
    exit 1
fi

# Assign the first argument to a descriptive variable
IP_ADDRESS="$1"

# Ping the IP address exactly 5 times
ping -c 5 "$IP_ADDRESS"
